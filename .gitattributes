# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Diff drivers
*.rs            diff=rust
*.md            diff=markdown

# Force LF (breaks inside Docker/Linux if CRLF)
Makefile        text eol=lf
Dockerfile.*    text eol=lf
docker-compose* text eol=lf

# Binary (never merge or diff)
*.pem           binary
*.key           binary
*.crt           binary

# Generated (skip diff and GitHub stats)
Cargo.lock      -diff linguist-generated
*.sql           linguist-detectable=false
openapi.yaml    linguist-documentation

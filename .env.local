# Local defaults for the proof of concept. Committed on purpose, so a clone runs with no setup step.
# Every value here is local-only and reaches nothing outside this machine. Never put a real credential in it.

# Application
HTTP_ADDRESS=0.0.0.0:8080
TAX_RULES_CACHE_TTL_SECONDS=30

# Database
DATABASE_HOST=congestion-tax-adm
DATABASE_PORT=5432
DATABASE_NAME=congestion_tax_adm
DATABASE_USER=congestion_tax_app_user
DATABASE_PASSWORD=congestion_tax_app_password
DATABASE_INITDB_ARGS=--auth-local=scram-sha-256 --auth-host=scram-sha-256

# Migrations
FLYWAY_URL=jdbc:postgresql://congestion-tax-adm:5432/congestion_tax_adm
FLYWAY_USER=postgres
FLYWAY_TABLE=schema_history
FLYWAY_PASSWORD=postgres
FLYWAY_LOCATIONS=filesystem:/flyway/sql
FLYWAY_CLEAN_DISABLED=true
FLYWAY_VALIDATE_MIGRATION_NAMING=true

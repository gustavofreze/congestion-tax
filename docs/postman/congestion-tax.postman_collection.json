{
  "info": {
    "_postman_id": "f6221396-133e-5276-b8fa-da581deb2c6d",
    "name": "Congestion Tax",
    "description": "Every operation the service publishes, in the order the collection runner needs them.\n\nThe folders mirror the documentation pages: `Health` renders `docs/HEALTH.md`, `Use cases` renders `docs/USE_CASES.md`, and `Queries` renders `docs/QUERIES.md`. Each request keeps the name of its `operationId` summary in `openapi.yaml`, so a request and its contract are found under the same words.\n\nRunning the whole collection top to bottom works on a service just started by `make start`, because it ships with the Gothenburg tax rules of 2013 and no request changes them.\n\n`baseUrl` is a collection variable, so the collection runs with no environment imported. Import `congestion-tax-local.postman_environment.json` to point it somewhere else.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "The operational probes, rendered in `docs/HEALTH.md`. They are contracts for the platform, not domain operations, which is why they sit apart from `Use cases`.",
      "item": [
        {
          "name": "Liveness check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reports the process as up', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/liveness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "liveness"
              ]
            },
            "description": "Reports whether the process is running. It touches no dependency, so it answers `200` for as long as the process answers at all."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/health/liveness",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "health",
                    "liveness"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n    \"status\": \"UP\"\n}"
            }
          ]
        },
        {
          "name": "Readiness check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reports every dependency it checked', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('status');",
                  "    pm.expect(body.checks).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Is ready to receive traffic', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "readiness"
              ]
            },
            "description": "Reports whether the service can serve traffic, which means the database answered. It returns `503` with the same diagnostic body when it did not, so the first assertion covers both outcomes and the second is the one that fails a service that is not ready."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/health/readiness",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "health",
                    "readiness"
                  ]
                }

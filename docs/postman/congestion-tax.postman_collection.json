          "name": "Congestion tax calculating",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Calculates the tax of the example of the challenge', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.amount).to.eql(89);",
                  "    pm.expect(body.currency).to.eql('SEK');",
                  "    pm.expect(body.days).to.have.lengthOf(6);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"city\": \"gothenburg\",\n    \"vehicle\": \"CAR\",\n    \"passages\": [\n        \"2013-01-14 21:00:00\",\n        \"2013-01-15 21:00:00\",\n        \"2013-02-07 06:23:27\",\n        \"2013-02-07 15:27:00\",\n        \"2013-02-08 06:27:00\",\n        \"2013-02-08 06:20:27\",\n        \"2013-02-08 14:35:00\",\n        \"2013-02-08 15:29:00\",\n        \"2013-02-08 15:47:00\",\n        \"2013-02-08 16:01:00\",\n        \"2013-02-08 16:48:00\",\n        \"2013-02-08 17:49:00\",\n        \"2013-02-08 18:29:00\",\n        \"2013-02-08 18:35:00\",\n        \"2013-03-26 14:25:00\",\n        \"2013-03-28 14:07:27\"\n    ]\n}",

    {
      "name": "Queries",
      "description": "The read operations, rendered in `docs/QUERIES.md`. They change nothing on the service.",
      "item": [
        {
          "name": "Find tax rules by city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Finds the tax rules of Gothenburg', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const rules = pm.response.json();",
                  "    pm.expect(rules.city).to.eql('gothenburg');",
                  "    pm.expect(rules.currency).to.eql('SEK');",
                  "    pm.expect(rules.periods).to.have.lengthOf(1);",
                  "    pm.expect(rules.periods[0].tariff_bands).to.have.lengthOf(9);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tax-rules/:city",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tax-rules",
                ":city"
              ],
              "variable": [
                {
                  "key": "city",
                  "value": "gothenburg",
                  "description": "City whose tax rules are found, matched without regard to case or surrounding spaces."
                }
              ]
            },
            "description": "Finds the tax rules a city keeps, as the editors of the city maintain them: the currency and every tax period, each with its tariff bands, toll free calendar, daily maximum, single charge window, and exempt vehicles. A city with no tax rules answers `404`."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/tax-rules/:city",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "tax-rules",
                    ":city"
                  ],
                  "variable": [
                    {
                      "key": "city",
                      "value": "gothenburg",
                      "description": "City whose tax rules are found, matched without regard to case or surrounding spaces."
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n    \"city\": \"gothenburg\",\n    \"periods\": [\n        {\n            \"starts_on\": \"2013-01-01\",\n            \"ends_on\": \"2013-12-31\",\n            \"tariff_bands\": [\n                {\n                    \"amount\": 8,\n                    \"starts_at\": \"06:00:00\",\n                    \"ends_at\": \"06:30:00\"\n                },\n                {\n                    \"amount\": 13,\n                    \"starts_at\": \"06:30:00\",\n                    \"ends_at\": \"07:00:00\"\n                },\n                {\n                    \"amount\": 18,\n                    \"starts_at\": \"07:00:00\",\n                    \"ends_at\": \"08:00:00\"\n                },\n                {\n                    \"amount\": 13,\n                    \"starts_at\": \"08:00:00\",\n                    \"ends_at\": \"08:30:00\"\n                },\n                {\n                    \"amount\": 8,\n                    \"starts_at\": \"08:30:00\",\n                    \"ends_at\": \"15:00:00\"\n                },\n                {\n                    \"amount\": 13,\n                    \"starts_at\": \"15:00:00\",\n                    \"ends_at\": \"15:30:00\"\n                },\n                {\n                    \"amount\": 18,\n                    \"starts_at\": \"15:30:00\",\n                    \"ends_at\": \"17:00:00\"\n                },\n                {\n                    \"amount\": 13,\n                    \"starts_at\": \"17:00:00\",\n                    \"ends_at\": \"18:00:00\"\n                },\n                {\n                    \"amount\": 8,\n                    \"starts_at\": \"18:00:00\",\n                    \"ends_at\": \"18:30:00\"\n                }\n            ],\n            \"exempt_vehicles\": [\n                \"BUS\",\n                \"DIPLOMAT\",\n                \"EMERGENCY\",\n                \"FOREIGN\",\n                \"MILITARY\",\n                \"MOTORCYCLE\"\n            ],\n            \"public_holidays\": [\n                \"2013-01-01\",\n                \"2013-01-06\",\n                \"2013-03-29\",\n                \"2013-03-31\",\n                \"2013-04-01\",\n                \"2013-05-01\",\n                \"2013-05-09\",\n                \"2013-05-19\",\n                \"2013-06-06\",\n                \"2013-06-22\",\n                \"2013-11-02\",\n                \"2013-12-25\",\n                \"2013-12-26\",\n                \"2014-01-01\"\n            ],\n            \"toll_free_months\": [\n                7\n            ],\n            \"toll_free_weekdays\": [\n                6,\n                7\n            ],\n            \"daily_maximum_amount\": 60,\n            \"single_charge_window_minutes\": 60,\n            \"toll_free_day_before_holiday\": true\n        }\n    ],\n    \"currency\": \"SEK\"\n}"
            },
